# ---- Required ----
# MongoDB connection string (local Community Server or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/artha
# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=5000

# ---- Optional (defaults shown) ----
NODE_ENV=development
JWT_EXPIRES_IN=2h
# bcrypt cost factor for password hashing (4-15; use >= 10 in production)
BCRYPT_ROUNDS=12
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# Python executable: "python3" on macOS/Linux, "python" on Windows
PYTHON_BIN=python3
PYTHON_TIMEOUT_MS=10000

# ---- Tests only ----
# Run the backend tests against a MongoDB you already have (e.g. the local Windows service)
# instead of downloading an in-memory one. Each test file creates and drops its own
# "artha_test_*" database, so your real "artha" data is never touched.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017
